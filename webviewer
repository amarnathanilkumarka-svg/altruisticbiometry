<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Altruistic - Continuous Per-Axis Engine</title>
    <style>
        body { font-family: -apple-system, sans-serif; background: #0f0f0f; color: #e0e0e0; padding: 15px; margin: 0; }
        .status-card { background: #1a1a1a; padding: 20px; border-radius: 12px; border-top: 4px solid #2196f3; margin-bottom: 20px; text-align: center; }
        .label { font-size: 11px; color: #777; text-transform: uppercase; margin-bottom: 8px; }
        #engineStatus { font-weight: 800; color: #2196f3; font-size: 1.4em; }
        
        .axis-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 20px; }
        .axis-box { background: #161616; padding: 12px; border-radius: 8px; border: 1px solid #333; text-align: center; }
        .axis-score { font-family: 'Courier New', monospace; font-size: 16px; font-weight: bold; color: #4caf50; display: block; }
        
        .progress-container { background: #222; height: 12px; border-radius: 6px; overflow: hidden; margin: 10px 0; position: relative; }
        .progress-bar { height: 100%; width: 0%; background: linear-gradient(90deg, #2196f3, #4caf50); transition: width 0.1s ease; }
        .threshold-line { position: absolute; left: 97.5%; top: 0; bottom: 0; border-left: 2px dashed #fff; opacity: 0.5; }

        .debug-panel { background: #121212; border: 1px solid #222; padding: 12px; border-radius: 8px; height: 120px; overflow-y: auto; font-family: 'Courier New', monospace; font-size: 11px; color: #666; }
    </style>
</head>
<body>

    <div class="status-card">
        <div class="label">Live Recognition Engine</div>
        <div id="engineStatus">WAITING FOR START</div>
    </div>

    <div class="axis-grid">
        <div class="axis-box"><span class="label">X-Axis</span><span id="scoreX" class="axis-score">0.000</span></div>
        <div class="axis-box"><span class="label">Y-Axis</span><span id="scoreY" class="axis-score">0.000</span></div>
        <div class="axis-box"><span class="label">Z-Axis</span><span id="scoreZ" class="axis-score">0.000</span></div>
    </div>

    <div class="label">Cosine Similarity (Goal: 0.975)</div>
    <div class="progress-container">
        <div id="totalProgress" class="progress-bar"></div>
        <div class="threshold-line"></div>
    </div>

    <div id="debugLog" class="debug-panel">App Inventor Signal: Awaiting "START"...</div>

<script>
const THRESHOLD = 0.975;
const IDLE_LIMIT = 0.025; 
var masterFP = null, masterBio = null, startTime = 0, isCalibrating = false;

// FFT helper
function FFT(n) { this.n = n; this.spectrum = new Float32Array(n/2); this.forward = function(buf) { for(let k=0; k<n/2; k++) { let r=0, i=0; for(let t=0; t<n; t++) { let a=(2*Math.PI*k*t)/n; r+=buf[t]*Math.cos(a); i-=buf[t]*Math.sin(a); } this.spectrum[k]=Math.sqrt(r*r+i*i)/n; } }; }

// Pearson Correlation
function pearson(a, b) {
    let n=a.length, sA=0, sB=0, sSqA=0, sSqB=0, pSum=0;
    for(let i=0; i<n; i++) { sA+=a[i]; sB+=b[i]; sSqA+=a[i]*a[i]; sSqB+=b[i]*b[i]; pSum+=a[i]*b[i]; }
    let num=pSum-(sA*sB/n), den=Math.sqrt((sSqA-sA*sA/n)*(sSqB-sB*sB/n));
    return den===0?0:num/den;
}

// Biometric Vector (Correlation of Axis Pairs)
function getBio(raw) {
    let s = [raw.slice(0, 128), raw.slice(128, 256), raw.slice(256, 384)].map(arr => {
        let m = arr.reduce((a,b)=>a+b)/128; return arr.map(v => v-m);
    });
    return [pearson(s[0], s[1]), pearson(s[0], s[2]), pearson(s[1], s[2])];
}

window.setInterval(function() {
    if (window.AppInventor) {
        let input = window.AppInventor.getWebViewString();
        if (input === "START") { masterFP = null; masterBio = null; startTime = Date.now(); isCalibrating = true; document.getElementById('engineStatus').innerText = "CALIBRATING..."; }
        else if (input.includes(",")) runEngine(input);
    }
}, 100);

function runEngine(data) {
    let raw = data.replace(/[\[\]"]/g, "").split(',').filter(Boolean).map(Number);
    if (raw.length !== 384) return;
    let current = { x: getVector(raw.slice(0, 128)), y: getVector(raw.slice(128, 256)), z: getVector(raw.slice(256, 384)) };
    
    if (isCalibrating) {
        handleCalibration(current, getBio(raw));
    } else {
        let avgSD = (current.x[8] + current.y[8] + current.z[8]) / 3;
        if (avgSD < IDLE_LIMIT) { document.getElementById('engineStatus').innerText = "IDLE"; resetUI(); }
        else if (masterFP) processSimilarity(current, getBio(raw));
    }
}

function handleCalibration(fp, bio) {
    let elapsed = Date.now() - startTime;
    if (elapsed < 10000) {
        if (!masterFP) { masterFP = fp; masterBio = bio; }
        else {
            for (let ax of ['x','y','z']) masterFP[ax] = masterFP[ax].map((v, i) => v + (fp[ax][i] - v) / 12);
            masterBio = masterBio.map((v, i) => v + (bio[i] - v) / 12);
        }
        document.getElementById('engineStatus').innerText = "LOCKING: " + Math.ceil((10000 - elapsed)/1000) + "s";
    } else {
        isCalibrating = false;
        document.getElementById('engineStatus').innerText = "READY";
        document.getElementById('debugLog').innerText = "Biometric Master Signature Set.";
    }
}

function processSimilarity(fp, bio) {
    let sx = cosSim(fp.x, masterFP.x), sy = cosSim(fp.y, masterFP.y), sz = cosSim(fp.z, masterFP.z);
    document.getElementById('scoreX').innerText = sx.toFixed(3);
    document.getElementById('scoreY').innerText = sy.toFixed(3);
    document.getElementById('scoreZ').innerText = sz.toFixed(3);
    let avg = (sx + sy + sz) / 3;
    document.getElementById('totalProgress').style.width = (avg * 100) + "%";

    // Gated Biometric Logic
    if (sx > THRESHOLD && sy > THRESHOLD && sz > THRESHOLD) {
        let bioSim = cosSim(bio, masterBio);
        document.getElementById('engineStatus').innerText = bioSim > 0.9 ? "MATCHED & VERIFIED" : "MATCHED / UNVERIFIED";
        document.getElementById('engineStatus').style.color = bioSim > 0.9 ? "#4caf50" : "#ff9800";
    } else {
        document.getElementById('engineStatus').innerText = "MISMATCH";
        document.getElementById('engineStatus').style.color = "#f44336";
    }
}

function getVector(sig) {
    let m = sig.reduce((a, b) => a + b, 0) / 128, c = sig.map(v => v - m);
    let f = new FFT(128); f.forward(c);
    let b = []; for(let i=0; i<8; i++) { let s=0; for(let j=0; j<8; j++) s+=f.spectrum[i*8+j]; b.push(s/8); }
    let t = b.reduce((a,b)=>a+b,0);
    let nb = t < 0.0001 ? new Array(8).fill(0) : b.map(v=>v/t);
    let sd = Math.sqrt(c.map(v=>v*v).reduce((a,b)=>a+b)/128);
    let zc = 0; for(let i=1; i<128; i++) if(c[i]*c[i-1]<0) zc++;
    return [...nb, sd, zc/128];
}

function cosSim(a, b) {
    let dot=0, nA=0, nB=0;
    for(let i=0; i<a.length; i++) { dot+=a[i]*b[i]; nA+=a[i]*a[i]; nB+=b[i]*b[i]; }
    return dot/(Math.sqrt(nA)*Math.sqrt(nB)||1);
}

function resetUI() {
    document.getElementById('totalProgress').style.width = "0%";
    ['scoreX', 'scoreY', 'scoreZ'].forEach(id => document.getElementById(id).innerText = "0.000");
}
</script>
</body>
</html>
